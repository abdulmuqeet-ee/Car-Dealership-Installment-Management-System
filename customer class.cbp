#include <iostream>
#include <string>

using namespace std;

class Customer {
private:
    int customerID;
    string name;
    string cnic;
    double monthlySalary;

public:
    Customer(int id, string n, string c, double salary)
        : customerID(id), name(n), cnic(c), monthlySalary(salary) {}

    int getID() const { return customerID; }
    string getName() const { return name; }
    string getCNIC() const { return cnic; }
    double getSalary() const { return monthlySalary; }
};
// this main function is just for test

int main() {
    Customer c1(101, "Abdullah", "12345-1234567-1", 75000);

    cout << "===== CUSTOMER DETAILS =====" << endl;
    cout << "Customer ID: " << c1.getID() << endl;
    cout << "Name: " << c1.getName() << endl;
    cout << "CNIC: " << c1.getCNIC() << endl;
    cout << "Monthly Salary: " << c1.getSalary() << endl;

    return 0;
}
